  1. Побудуйте ER-діаграму вашої бази даних у будь-якому зручному
//     інструменті — dbdiagram.io, draw.io, Lucidchart тощо.

// Вставте ваш DBML-код нижче 👇

Table locations {
  location_id int [pk, increment]
  name varchar(50) [not null]
  address varchar(50) [not null]
  city varchar(50) [not null]
  }

Table staff {
  staff_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  role varchar(50) [not null]
  phone varchar(20)
  email varchar(100) [unique]
  location_id int [not null]
}

Ref: staff.location_id > locations.location_id

Table menu_items {
  item_id int [pk, increment]
  location_id int [not null]
  name varchar(100) [not null]
  category varchar(50) [not null]
  price decimal(10,2) [not null]
  preparation_time int 
  description varchar(255)
}
Ref: menu_items.location_id > locations.location_id

Table orders {
  order_id int [pk, increment]
  staff_id int [not null]
  order_number varchar(20) [unique, not null]
  order_type varchar(20) [not null]
  status varchar(20) [not null]
  location_id int [not null]
  order_date datetime [not null]
}
Ref: orders.location_id > locations.location_id
Ref: orders.staff_id > staff.staff_id

Table order_items {
  order_item_id int [pk, increment]
  order_id int [not null]
  item_id int [not null]
  quantity int [not null]
  unit_price decimal(10,2) [not null]
}

Ref: order_items.order_id > orders.order_id
Ref: order_items.item_id > menu_items.item_id


Table basic_inventory {
  inventory_id int [pk, increment]
  item_name varchar(100) [not null]
  quantity decimal(10,2) [not null]
  unit varchar(20) [not null]
  location_id int [not null]
}

Ref: basic_inventory.location_id > locations.location_id

Table restaurant_tables {
  table_id int [pk, increment]
  location_id int [not null]
  table_number int [not null]
  capacity int [not null]
  status varchar(20) [not null, default: 'available']
}

Ref: restaurant_tables.location_id > locations.location_id

Table reservations {
  reservation_id int [pk, increment]
  location_id int [not null]
  table_id int [not null]
  customer_name varchar(100) [not null]
  customer_phone varchar(20)
  reservation_date date [not null]
  reservation_time time [not null]
  guests int [not null]
  status varchar(20) [not null, default: 'pending']
}
Ref: reservations.location_id > locations.location_id
Ref: reservations.table_id > restaurant_tables.table_id

Table ingredients {
  ingredient_id int [pk, increment]
  location_id int [not null]
  name varchar(100) [not null]
  unit varchar(20) [not null]
  quantity decimal(10,2) [not null]
}

Ref: ingredients.location_id > locations.location_id

Table suppliers {
  supplier_id int [pk, increment]
  name varchar(100) [not null]
  phone varchar(20)
  email varchar(100) [unique]
  address varchar(150)
}

Table supplier_ingredients {
  supplier_id int [not null]
  ingredient_id int [not null]

  indexes {
    (supplier_id, ingredient_id) [pk]
  }
}

Ref: supplier_ingredients.ingredient_id > ingredients.ingredient_id
Ref: supplier_ingredients.supplier_id > suppliers.supplier_id

Table customer_feedback {
  feedback_id int [pk, increment]
  location_id int [not null]
  customer_name varchar(100) [not null]
  customer_email varchar(100)
  rating int [not null]
  comment text
  feedback_date date [not null, default: `CURRENT_DATE`]
}
Ref: customer_feedback.location_id > locations.location_id
